# *********** No editable content below this line **************

$wpl_allowed = 0;
foreach ($wpl_allowedIPs as $IP) {
    if ($_SERVER["REMOTE_ADDR"] == $IP)
        $wpl_allowed = 1;
}

if ($wpl_allowed == 0) {
    header("HTTP/1.0 404 Not Found");
    die();
}

