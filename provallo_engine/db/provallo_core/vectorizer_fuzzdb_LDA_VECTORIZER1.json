byte b[] = null;
while(l > 1024L){
	b = new byte[1024];
	fin.read(b,0,1024);
	fout.write(b);
	b=null;
	l -= 1024L;
	}
if(l > 0){
	b = new byte[(int)l];
	fin.read(b,0,(int)l);
	fout.write(b);
	}


ByteArrayOutputStream baos = new ByteArrayOutputStream();
while((c = fin.read()) != -1){
	baos.write(c);
	}
String laststring = baos.toString();
int idx = laststring.indexOf(boundary);
b = baos.toByteArray();
if(idx > 2){
	fout.write(b,0,idx-2);
	}else{
	fout.close();
	newfile.delete();
	return;
	}
fout.flush();
fout.close();
fin.close();

out.println("FileName: " + newfile.getName());
out.println("FileSize: " + newfile.length());

