this.SaveAs  =  jsSaveAs
}
function  jsBinaryToString(){
return  BinaryToString(this.ByteArray)
}
function  jsSaveAs(FileName){
return  vbsSaveAs(FileName,  this.ByteArray)
}
</SCRIPT>
